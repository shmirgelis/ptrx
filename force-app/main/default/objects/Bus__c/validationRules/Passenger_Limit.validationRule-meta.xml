<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passenger_Limit</fullName>
    <active>false</active>
    <description>Limit 20 passengers per bus</description>
    <errorConditionFormula>Number_Of_Passengers__c  &gt; 20</errorConditionFormula>
    <errorMessage>Only 20 passengers allowed on the bus</errorMessage>
</ValidationRule>
